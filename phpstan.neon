parameters:
    level: 8
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Ignorer les erreurs de concaténation avec les chemins de fichiers
        - '#Binary operation "." between array\|bool\|float\|int\|string\|UnitEnum\|null and non-falsy-string results in an error#'
        # Pattern plus générique pour toutes les erreurs de concaténation
        - '#Binary operation "." between .+ and .+ results in an error#'
        # Ignorer les erreurs sur les appels de méthode sur des objets possiblement null
        - '#Cannot call method .+\(\) on .+\|null#'
        # Ignorer les erreurs sur les variables toujours existantes avec ??
        - '#Variable .+ on left side of \?\? always exists and is not nullable#'
        # Ignorer les erreurs spécifiques à Doctrine
        - '#Call to an undefined method .*::createQueryBuilder\(\)#'
        - '#Property .*::\$id .* is never assigned int#'