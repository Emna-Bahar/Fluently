{% extends 'base.html.twig' %}

{% block title %}{{ langue.nom }} – Ton parcours d'apprentissage{% endblock %}

{% block body %}
<div style="background: linear-gradient(135deg, #4f46e5 0%, #6d28d9 100%); min-height: 100vh; padding: 60px 20px; color: white; position: relative; overflow-x: hidden;">
<br><br><br><br><br>
    <div style="position: absolute; inset: 0; pointer-events: none; opacity: 0.12; font-size: 3.5rem; user-select: none;">
        <div style="position: absolute; top: 10%; left: 8%; animation: float 14s infinite;">✨</div>
        <div style="position: absolute; top: 35%; right: 14%; animation: float 16s infinite;">⭐</div>
        <div style="position: absolute; bottom: 22%; left: 16%; animation: float 20s infinite;">🌟</div>
        <div style="position: absolute; bottom: 48%; right: 18%; animation: float 12s infinite;">💫</div>
    </div>

    <style>
        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-40px) rotate(10deg); }
        }
    </style>

    <div style="max-width: 1100px; margin: 0 auto; position: relative; z-index: 2;">
        <div style="text-align: center; margin-bottom: 70px;">
            <h1 style="font-size: 3.8rem; font-weight: 900; margin: 0; color: white; text-shadow: 0 6px 20px rgba(0,0,0,0.5);">
                {{ langue.nom }}
            </h1>
            <p style="font-size: 1.5rem; margin-top: 16px; opacity: 0.9; font-weight: 500;">
                Complète les unités pour progresser niveau par niveau !
            </p>
            
            {% if niveauUtilisateur %}
                <div style="margin-top: 30px; padding: 15px 30px; background: rgba(255,255,255,0.15); border-radius: 60px; display: inline-block; backdrop-filter: blur(10px); border: 2px solid rgba(255,255,255,0.3);">
                    <span style="font-size: 1.3rem; font-weight: 600; margin-right: 15px;">🎓 Ton niveau actuel :</span>
                    <span style="background: linear-gradient(135deg, #fbbf24, #f59e0b); padding: 10px 25px; border-radius: 40px; font-weight: 900; font-size: 1.6rem; color: #1e293b; box-shadow: 0 10px 25px rgba(0,0,0,0.3);">
                        {{ niveauObtenu }}
                    </span>
                </div>
            {% endif %}
            <div style="margin-top: 30px; padding: 15px 30px; background: rgba(255,255,255,0.15); border-radius: 60px; display: inline-block; backdrop-filter: blur(10px); border: 2px solid rgba(255,255,255,0.3);">
            <a href="{{ path('app_etudiant_analyse', {langueId: langue.id}) }}" class="btn btn-lg btn-primary">
                <i class="fas fa-chart-line"></i> 📊 Mon Analyse de Performance
            </a>
            </div>
        </div>

        <div style="position: relative; padding: 80px 0;">
            <div style="position: absolute; top: 0; bottom: 0; left: 50%; width: 10px; background: linear-gradient(to bottom, rgba(255,255,255,0.6), rgba(255,255,255,0.15)); transform: translateX(-50%); border-radius: 5px; z-index: 1;"></div>

            <!-- TEST DE NIVEAU -->
            <div style="position: relative; margin: 0 auto 180px; text-align: center; z-index: 3; max-width: 300px;">
                {% if testNiveau %}
                    {% if dernierPassage %}
                        <div style="width: 220px; height: 220px; margin: 0 auto; background: linear-gradient(135deg, #10b981, #059669); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 20px 70px rgba(16,185,129,0.6);">
                            <span style="font-size: 5.5rem; line-height: 1; color: white;">{{ niveauObtenu }}</span>
                            <span style="font-size: 1.4rem; font-weight: 900; color: white; margin-top: 8px;">Niveau</span>
                        </div>
                        <p style="margin-top: 32px; font-size: 1.9rem; font-weight: 800; color: white; text-shadow: 0 4px 12px rgba(0,0,0,0.5);">
                            Test de niveau terminé !
                        </p>
                        <p style="margin-top: 12px; font-size: 1.3rem; color: rgba(255,255,255,0.9);">
                            Score : {{ dernierPassage.resultat|number_format(1, '.', '') }}% • 
                            Temps : {{ (dernierPassage.tempsPasse / 60)|number_format(0) }} min
                        </p>
                        <a href="{{ path('app_test_student_result', {id: dernierPassage.id}) }}" 
                           style="display: inline-block; margin-top: 20px; background: rgba(255,255,255,0.2); color: white; padding: 12px 30px; border-radius: 30px; text-decoration: none; font-weight: 700; transition: all 0.3s;"
                           onmouseover="this.style.background='rgba(255,255,255,0.3)';"
                           onmouseout="this.style.background='rgba(255,255,255,0.2)';">
                            Voir les détails
                        </a>
                    {% else %}
                        <form method="post" action="{{ path('app_test_student_start', {id: testNiveau.id}) }}">
                            <button type="submit" 
                                    style="width: 220px; height: 220px; margin: 0 auto; background: linear-gradient(135deg, #fbbf24, #f59e0b); border: none; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 20px 70px rgba(251,191,36,0.6); cursor: pointer; transition: all 0.4s;" 
                                    onmouseover="this.style.transform='scale(1.12) rotate(8deg)';" 
                                    onmouseout="this.style.transform='scale(1) rotate(0deg)';">
                                <span style="font-size: 7rem; line-height: 1;">📝</span>
                                <span style="font-size: 1.8rem; font-weight: 900; color: #1e293b; margin-top: 12px;">COMMENCER</span>
                            </button>
                        </form>
                        <p style="margin-top: 32px; font-size: 2rem; font-weight: 800; color: white; text-shadow: 0 4px 12px rgba(0,0,0,0.5);">
                            Évalue ton niveau actuel
                        </p>
                        <p style="margin-top: 12px; font-size: 1.2rem; color: rgba(255,255,255,0.85);">
                            {{ testNiveau.questions|length }} questions • {{ testNiveau.dureeEstimee ?: '15' }} minutes
                        </p>
                    {% endif %}
                {% else %}
                    <div style="width: 220px; height: 220px; margin: 0 auto; background: linear-gradient(135deg, #9ca3af, #6b7280); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 16px 60px rgba(107,114,128,0.4);">
                        <span style="font-size: 7rem; line-height: 1;">🔒</span>
                        <span style="font-size: 1.8rem; font-weight: 900; color: #1e293b; margin-top: 12px;">NON DISPONIBLE</span>
                    </div>
                    <p style="margin-top: 32px; font-size: 1.8rem; font-weight: 700; color: white; text-shadow: 0 4px 12px rgba(0,0,0,0.5);">
                        Test de niveau bientôt disponible
                    </p>
                    <p style="margin-top: 12px; font-size: 1.1rem; color: rgba(255,255,255,0.8);">
                        Notre équipe travaille dessus !
                    </p>
                {% endif %}
            </div>

            {% set niveauxListe = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'] %}
            {% set couleurs = ['#22c55e', '#3b82f6', '#8b5cf6', '#f59e0b', '#ef4444', '#7c3aed'] %}
            
            {# Créer un dictionnaire des cours par niveau #}
            {% set coursParNiveau = {} %}
            {% for cours in allCours %}
                {% set niveauDiff = cours.IdNiveau.difficulte %}
                {% if not coursParNiveau[niveauDiff] is defined %}
                    {% set coursParNiveau = coursParNiveau|merge({(niveauDiff): []}) %}
                {% endif %}
                {% set coursParNiveau = coursParNiveau|merge({(niveauDiff): coursParNiveau[niveauDiff]|merge([cours])}) %}
            {% endfor %}
            
            {% for niveauIndex in 0..5 %}
                {% set niveauNom = niveauxListe[niveauIndex] %}
                {% set niveauCouleur = couleurs[niveauIndex] %}
                {% set coursNiveau = coursParNiveau[niveauNom]|default([]) %}
                
                <div style="position: relative; margin: {% if niveauIndex == 0 %}0{% else %}80{% endif %}px 0 40px; text-align: center; z-index: 3;">
                    <div style="font-size: 2.5rem; font-weight: 900; color: white; margin-bottom: 30px; text-shadow: 0 6px 16px rgba(0,0,0,0.5); background: {{ niveauCouleur }}30; display: inline-block; padding: 10px 40px; border-radius: 50px; backdrop-filter: blur(5px);">
                        Niveau {{ niveauNom }}
                    </div>
                </div>
                
                <div style="display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; margin-bottom: 40px;">
                    {% for numero in 1..3 %}
                        {% set coursExiste = false %}
                        {% set coursItem = null %}
                        {% set isCompleted = false %}
                        
                        {% for cours in coursNiveau %}
                            {% if cours.numero == numero %}
                                {% set coursExiste = true %}
                                {% set coursItem = cours %}
                                {# Vérifier si le cours est terminé #}
                                {# APRÈS — distingue par niveau #}
{% set niveauIdCourant = 0 %}
{% for c in coursNiveau %}
    {% if c.numero == numero %}
        {% set niveauIdCourant = c.IdNiveau.id %}
    {% endif %}
{% endfor %}
{% if niveauIdCourant > 0 and progressParNiveau[niveauIdCourant] is defined %}
    {% if progressParNiveau[niveauIdCourant].dernierNumeroCours >= numero %}
        {% set isCompleted = true %}
    {% endif %}
{% endif %}
                            {% endif %}
                        {% endfor %}
                        
                        <div style="text-align: center;">
                            {% if coursExiste %}
                                {# TOUS LES CERCLES SONT ACCÉSSIBLES - plus de condition de déblocage #}
                                <a href="{{ path('app_cours_show', {id: coursItem.id}) }}" style="text-decoration: none;">
                                    <div style="
                                        width: 140px;
                                        height: 140px;
                                        margin: 0 auto;
                                        background: {% if isCompleted %}#10b981{% else %}{{ niveauCouleur }}{% endif %};
                                        border-radius: 50%;
                                        display: flex;
                                        flex-direction: column;
                                        align-items: center;
                                        justify-content: center;
                                        box-shadow: 0 16px 40px rgba(0,0,0,0.3);
                                        transition: all 0.3s ease;
                                        position: relative;
                                        border: 4px solid rgba(255,255,255,0.5);
                                        cursor: pointer;
                                    " 
                                    onmouseover="this.style.transform='scale(1.1)'; this.style.boxShadow='0 25px 50px rgba(0,0,0,0.4)';" 
                                    onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='0 16px 40px rgba(0,0,0,0.3)';">
                                        
                                        <span style="font-size: 3.8rem; font-weight: 900; color: white; text-shadow: 2px 2px 8px rgba(0,0,0,0.3);">
                                            {{ numero }}
                                        </span>
                                        
                                        {% if isCompleted %}
                                            <div style="position: absolute; top: -8px; right: -8px; background: #10b981; color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; box-shadow: 0 5px 15px rgba(16,185,129,0.5); border: 3px solid white;">
                                                ✓
                                            </div>
                                        {% endif %}
                                    </div>
                                    <p style="margin-top: 15px; font-size: 1.2rem; font-weight: 600; color: white; text-shadow: 0 2px 5px rgba(0,0,0,0.3);">
                                        Unité {{ numero }}
                                        {% if isCompleted %}
                                            <span style="display: block; font-size: 0.8rem; color: #a5f3fc;">✓ Terminé</span>
                                        {% endif %}
                                    </p>
                                </a>
                            {% else %}
                                {# Cercle grisé (cours non disponible dans la base) #}
                                <div style="
                                    width: 140px;
                                    height: 140px;
                                    margin: 0 auto;
                                    background: #6b7280;
                                    border-radius: 50%;
                                    display: flex;
                                    flex-direction: column;
                                    align-items: center;
                                    justify-content: center;
                                    box-shadow: 0 16px 40px rgba(0,0,0,0.2);
                                    position: relative;
                                    border: 4px solid rgba(255,255,255,0.2);
                                    opacity: 0.6;
                                    cursor: default;
                                ">
                                    <span style="font-size: 3.8rem; font-weight: 900; color: white; text-shadow: 2px 2px 8px rgba(0,0,0,0.3);">
                                        {{ numero }}
                                    </span>
                                    <div style="position: absolute; top: -8px; right: -8px; background: #ef4444; color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; box-shadow: 0 5px 15px rgba(239,68,68,0.5); border: 3px solid white;">
                                        🔒
                                    </div>
                                </div>
                                <p style="margin-top: 15px; font-size: 1.2rem; font-weight: 600; color: rgba(255,255,255,0.5); text-shadow: 0 2px 5px rgba(0,0,0,0.3);">
                                    Unité {{ numero }}
                                    <span style="display: block; font-size: 0.8rem;">Bientôt disponible</span>
                                </p>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
                
                {# Test de fin de niveau - s'affiche seulement s'il existe #}
                {% set testFinNiveau = null %}
                {% for test in testsLangue %}
                    {% if test.type == 'Test de fin de niveau' and test.niveau and test.niveau.difficulte == niveauNom %}
                        {% set testFinNiveau = test %}
                    {% endif %}
                {% endfor %}

                {% if testFinNiveau %}
                    {% set tousCoursDuNiveauExistants = true %}
                    {% set tousCoursTermines = true %}
                    {% for num in 1..3 %}
                        {% set coursTrouve = false %}
                        {% for cours in coursNiveau %}
                            {% if cours.numero == num %}
                                {% set coursTrouve = true %}
                                {% if progress.dernierNumeroCours < num %}
                                    {% set tousCoursTermines = false %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                        {% if not coursTrouve %}
                            {% set tousCoursDuNiveauExistants = false %}
                        {% endif %}
                    {% endfor %}
                    
                    {% set testDejaPassé = false %}
                    {% for passage in testFinNiveau.passages %}
                        {% if passage.user.id == user.id and passage.statut == 'termine' %}
                            {% set testDejaPassé = true %}
                        {% endif %}
                    {% endfor %}
                    
                    {% set testDisponible = true %} {# TOUJOURS DISPONIBLE #}
                    
                    <div style="text-align: center; margin: 30px 0 60px;">
                        <a href="{{ path('app_test_student_show', {id: testFinNiveau.id}) }}" style="text-decoration: none;">
                        
                        <div style="
                            width: 120px;
                            height: 120px;
                            margin: 0 auto;
                            background: {% if testDejaPassé %}linear-gradient(135deg, #10b981, #059669){% else %}linear-gradient(135deg, #fbbf24, #f59e0b){% endif %};
                            border-radius: 50%;
                            display: flex;
                            flex-direction: column;
                            align-items: center;
                            justify-content: center;
                            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
                            transition: all 0.3s ease;
                            position: relative;
                            border: 4px solid rgba(255,255,255,0.5);
                            cursor: pointer;
                        " 
                        onmouseover="this.style.transform='scale(1.1)'; this.style.boxShadow='0 15px 30px rgba(0,0,0,0.4)';" 
                        onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='0 10px 30px rgba(0,0,0,0.3)';">
                            
                            <span style="font-size: 3rem; line-height: 1;">
                                {% if testDejaPassé %}✅{% else %}📝{% endif %}
                            </span>
                            <span style="font-size: 0.9rem; font-weight: 800; color: white; margin-top: 5px; text-align: center;">
                                TEST<br>FIN NIVEAU
                            </span>

                            {% if testDejaPassé %}
                                <div style="position: absolute; top: -8px; right: -8px; background: #10b981; color: white; width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; box-shadow: 0 5px 15px rgba(16,185,129,0.5); border: 2px solid white;">
                                    ✓
                                </div>
                            {% endif %}
                        </div>

                        <p style="margin-top: 12px; font-size: 0.9rem; font-weight: 600; color: rgba(255,255,255,0.8);">
                            {% if testDejaPassé %}
                                ✓ Test validé
                            {% else %}
                                🎯 Test disponible
                            {% endif %}
                        </p>

                        </a>
                    </div>
                {% endif %}
            {% endfor %}
            
            {# ============ TESTS HORS PARCOURS (À DROITE) ============ #}
            <div style="position: fixed; right: 30px; top: 50%; transform: translateY(-50%); z-index: 10; display: flex; flex-direction: column; gap: 30px;">

                {% set testsHorsParcours = [] %}
                {% for test in testsLangue %}  
                    {% if test.type not in ['Test de niveau', 'Test de fin de niveau'] %}
                        {% set testsHorsParcours = testsHorsParcours|merge([test]) %}
                    {% endif %}
                {% endfor %}

                {% if testsHorsParcours|length > 0 %}
                    {% for test in testsHorsParcours %}
                        {% set testPassé = false %}
                        {% if app.user %}
                            {% for passage in test.passages %}
                                {% if passage.user.id == app.user.id and passage.statut == 'termine' %}
                                    {% set testPassé = true %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}

                        <a href="{{ path('app_test_student_show', {id: test.id}) }}" 
                        style="text-decoration: none; display: block;"
                        title="{{ test.titre }}">
                            <div style="
                                width: 100px;
                                height: 100px;
                                background: {% if testPassé %}linear-gradient(135deg, #10b981, #059669){% else %}linear-gradient(135deg, #3b82f6, #1d4ed8){% endif %};
                                border-radius: 50%;
                                display: flex;
                                flex-direction: column;
                                align-items: center;
                                justify-content: center;
                                box-shadow: 0 10px 30px rgba(0,0,0,0.4);
                                transition: all 0.3s ease;
                                border: 4px solid rgba(255,255,255,0.7);
                                position: relative;
                                cursor: pointer;
                            " 
                            onmouseover="this.style.transform='scale(1.1) rotate(5deg)'; this.style.boxShadow='0 15px 40px rgba(0,0,0,0.5)';" 
                            onmouseout="this.style.transform='scale(1) rotate(0deg)'; this.style.boxShadow='0 10px 30px rgba(0,0,0,0.4)';">
                                
                                <span style="font-size: 2.5rem; line-height: 1;">
                                    {% if testPassé %}✅{% else %}📝{% endif %}
                                </span>
                                <span style="font-size: 0.7rem; font-weight: 800; color: white; margin-top: 5px; text-align: center; line-height: 1.1;">
                                    TEST
                                </span>

                                {% if testPassé %}
                                    <div style="position: absolute; top: -6px; right: -6px; background: #10b981; color: white; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; box-shadow: 0 5px 15px rgba(16,185,129,0.5); border: 2px solid white;">
                                        ✓
                                    </div>
                                {% endif %}
                            </div>
                        </a>
                    {% endfor %}
                {% else %}
                    <div style="
                        width: 100px;
                        height: 100px;
                        background: linear-gradient(135deg, #9ca3af, #6b7280);
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        border: 4px solid rgba(255,255,255,0.4);
                        opacity: 0.6;
                    ">
                        <span style="font-size: 2.5rem;">🔒</span>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}