{% extends 'base.html.twig' %}

{% block title %}Leçon {{ cour.numero }} – {{ cour.idNiveau.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .filter-btn {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .filter-btn.active {
            background: linear-gradient(135deg, #8b5cf6, #6d28d9);
            transform: scale(1.02);
        }
        .ressource-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .ressource-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
        }
        .section-toggle {
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .section-toggle:hover {
            background: rgba(0,0,0,0.3);
        }
        .section-content {
            transition: all 0.3s ease;
        }
        .btn-terminer {
            background: linear-gradient(135deg, #10b981, #059669);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn-terminer:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(16,185,129,0.4);
        }
    </style>
{% endblock %}

{% block body %}
<div style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); min-height: 100vh; padding: 40px 20px; color: white; font-family: system-ui, sans-serif;">
    <div style="max-width: 1100px; margin: 0 auto;">
      <br><br><br><br><br>  
        <!-- En-tête -->
        <div style="text-align: center; margin-bottom: 40px;">
            <div style="display: inline-block; padding: 6px 20px; background: rgba(255,255,255,0.15); border-radius: 60px; margin-bottom: 20px; backdrop-filter: blur(4px);">
                <span style="font-size: 0.8rem; letter-spacing: 2px;">{{ cour.idNiveau.difficulte }}</span>
            </div>
            <h1 style="font-size: 3rem; font-weight: 900; margin: 0 0 12px; background: linear-gradient(135deg, #ffffff, #c4b5fd); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Leçon {{ cour.numero }}
            </h1>
            <p style="font-size: 1.1rem; color: rgba(255,255,255,0.85); margin: 0 0 20px;">
                {{ cour.idNiveau.titre }} • {{ cour.idNiveau.idLangue.nom }}
            </p>
            
            <!-- Bouton générer cours personnalisé -->
            <a href="{{ path('app_cours_personnalise_generer', {id: cour.id}) }}" 
               style="display: inline-flex; align-items: center; gap: 10px; background: linear-gradient(135deg, #f97316, #ea580c); color: white; padding: 12px 30px; border-radius: 60px; text-decoration: none; font-weight: 600; font-size: 0.9rem; box-shadow: 0 8px 20px rgba(249,115,22,0.3); transition: all 0.3s;"
               onmouseover="this.style.transform='scale(1.05)'; this.style.boxShadow='0 12px 30px rgba(249,115,22,0.5)';"
               onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='0 8px 20px rgba(249,115,22,0.3)';">
                <span>🎓</span> Générer un cours personnalisé
            </a>
        </div>
        
        <!-- Filtrage -->
        <div style="margin-bottom: 40px; text-align: center;">
            <div style="display: inline-flex; flex-wrap: wrap; gap: 10px; justify-content: center; background: rgba(0,0,0,0.2); padding: 6px 12px; border-radius: 60px; backdrop-filter: blur(4px);">
                <button class="filter-btn active" data-filter="all" style="background: #6366f1; color: white; padding: 8px 20px; border: none; border-radius: 60px; font-weight: 600; cursor: pointer; font-size: 0.85rem;">Tous</button>
                <button class="filter-btn" data-filter="pdf" style="background: rgba(255,255,255,0.1); color: white; padding: 8px 20px; border: none; border-radius: 60px; font-weight: 600; cursor: pointer; font-size: 0.85rem;">PDF</button>
                <button class="filter-btn" data-filter="video" style="background: rgba(255,255,255,0.1); color: white; padding: 8px 20px; border: none; border-radius: 60px; font-weight: 600; cursor: pointer; font-size: 0.85rem;">Vidéo</button>
                <button class="filter-btn" data-filter="image" style="background: rgba(255,255,255,0.1); color: white; padding: 8px 20px; border: none; border-radius: 60px; font-weight: 600; cursor: pointer; font-size: 0.85rem;">Image</button>
                <button class="filter-btn" data-filter="audio" style="background: rgba(255,255,255,0.1); color: white; padding: 8px 20px; border: none; border-radius: 60px; font-weight: 600; cursor: pointer; font-size: 0.85rem;">Audio</button>
                <button class="filter-btn" data-filter="other" style="background: rgba(255,255,255,0.1); color: white; padding: 8px 20px; border: none; border-radius: 60px; font-weight: 600; cursor: pointer; font-size: 0.85rem;">Autres</button>
            </div>
        </div>
        
        <!-- Conteneur ressources -->
        <div id="ressources-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 25px; margin-bottom: 40px;">
            
            {% if files|length > 0 %}
                {% for res in files %}
                    {% set isYoutube = res matches '/(youtube\\.com|youtu\\.be)/i' %}

                    {% if isYoutube %}
                        {% set type = 'video' %}
                    {% else %}
                        {% set ext = res|split('.')|last|lower %}
                        {% set type = 'other' %}
                        {% if ext in ['pdf'] %}{% set type = 'pdf' %}
                        {% elseif ext in ['mp4','webm','mov'] %}{% set type = 'video' %}
                        {% elseif ext in ['jpg','jpeg','png','gif','webp','svg'] %}{% set type = 'image' %}
                        {% elseif ext in ['mp3','wav','ogg','m4a'] %}{% set type = 'audio' %}
                        {% endif %}
                    {% endif %}

                    <div class="ressource-card" data-type="{{ type }}" style="background: rgba(255,255,255,0.95); border-radius: 20px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1); display: none;">
                        <div style="padding: 25px;">
                            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 15px;">
                                <div style="background: linear-gradient(135deg, #8b5cf6, #6d28d9); width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                    <span style="font-size: 1.5rem;">
                                        {% if isYoutube %}🎥
                                        {% elseif type == 'pdf' %}📄
                                        {% elseif type == 'video' %}🎥
                                        {% elseif type == 'image' %}🖼️
                                        {% elseif type == 'audio' %}🎵
                                        {% else %}📎{% endif %}
                                    </span>
                                </div>
                                <h3 style="margin: 0; color: #1e293b; font-size: 1.2rem; font-weight: 700;">
                                    {{ isYoutube ? 'Vidéo YouTube' : type|capitalize }}
                                </h3>
                            </div>

                            {% if isYoutube %}
                                {% set clean = res|trim %}
                                {% set videoId = '' %}

                                {% if 'youtu.be/' in clean %}
                                    {% set videoId = clean|split('youtu.be/')[1]|split('?')[0]|trim %}
                                {% elseif 'youtube.com/watch?v=' in clean %}
                                    {% set videoId = clean|split('v=')[1]|split('&')[0]|trim %}
                                {% elseif 'youtube.com/embed/' in clean %}
                                    {% set videoId = clean|split('embed/')[1]|split('?')[0]|trim %}
                                {% endif %}

                                {% if videoId|length == 11 %}
                                    <div class="ratio ratio-16x9 rounded-3 overflow-hidden shadow-lg">
                                        <iframe 
                                            src="https://www.youtube.com/embed/{{ videoId }}?rel=0&modestbranding=1&showinfo=0&controls=1&autoplay=0" 
                                            title="Vidéo YouTube" 
                                            frameborder="0" 
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                                            allowfullscreen>
                                        </iframe>
                                    </div>
                                {% else %}
                                    <div class="alert alert-warning text-center p-3 rounded-3">
                                        <small>⚠️ Lien YouTube invalide</small>
                                    </div>
                                {% endif %}

                            {% else %}
                                {% set filename = res|split('/')|last|split('\\')|last %}
                                {% set filePath = path('app_cours_ressource', {filename: filename}) %}

                                {% if type == 'image' %}
                                    <img src="{{ filePath }}" alt="Ressource" style="width: 100%; border-radius: 12px;">
                                {% elseif type == 'video' %}
                                    <video controls style="width: 100%; border-radius: 12px;">
                                        <source src="{{ filePath }}" type="video/{{ ext }}">
                                    </video>
                                {% elseif type == 'pdf' %}
                                    <a href="{{ filePath }}" target="_blank" style="display: flex; align-items: center; justify-content: center; gap: 10px; background: linear-gradient(135deg, #f97316, #ea580c); color: white; padding: 12px 24px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: all 0.3s; width: fit-content; margin: 0 auto;" 
                                       onmouseover="this.style.transform='scale(1.03)';" 
                                       onmouseout="this.style.transform='scale(1)';">
                                        <span>📄</span> Ouvrir le PDF
                                    </a>
                                {% elseif type == 'audio' %}
                                    <audio controls style="width: 100%; margin-top: 10px;">
                                        <source src="{{ filePath }}" type="audio/{{ ext }}">
                                    </audio>
                                {% else %}
                                    <div style="padding: 30px; background: #f1f5f9; border-radius: 12px; text-align: center;">
                                        <p style="margin: 0 0 12px; font-size: 0.9rem;">{{ filename }}</p>
                                        <a href="{{ filePath }}" download style="display: inline-flex; align-items: center; gap: 8px; background: #6366f1; color: white; padding: 8px 20px; border-radius: 50px; text-decoration: none; font-size: 0.8rem;">
                                            📥 Télécharger
                                        </a>
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
            
            {% if ressources_personnalisees is defined and ressources_personnalisees|length > 0 %}
                {% for res in ressources_personnalisees %}
                    <div class="ressource-card" data-type="pdf" style="background: rgba(255,255,255,0.95); border-radius: 20px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1); display: none;">
                        <div style="padding: 25px;">
                            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 15px;">
                                <div style="background: linear-gradient(135deg, #8b5cf6, #6d28d9); width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                    <span style="font-size: 1.5rem;">📄</span>
                                </div>
                                <h3 style="margin: 0; color: #1e293b; font-size: 1.2rem; font-weight: 700;">
                                    Cours personnalisé
                                </h3>
                            </div>
                            
                            <div style="text-align: center; margin-bottom: 15px; padding: 10px; background: #fef3c7; border-radius: 10px;">
                                <p style="margin: 0; color: #92400e; font-size: 0.8rem;">
                                    ✨ Contenu généré par IA
                                </p>
                            </div>
                            
                            <a href="{{ res }}" target="_blank" style="display: flex; align-items: center; justify-content: center; gap: 10px; background: linear-gradient(135deg, #f97316, #ea580c); color: white; padding: 12px 24px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: all 0.3s; width: fit-content; margin: 0 auto;" 
                               onmouseover="this.style.transform='scale(1.03)';" 
                               onmouseout="this.style.transform='scale(1)';">
                                <span>📄</span> Ouvrir le PDF
                            </a>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}

            {% if files|length == 0 and (ressources_personnalisees is not defined or ressources_personnalisees|length == 0) %}
                <div style="grid-column: 1 / -1; text-align: center; padding: 60px 40px; background: rgba(255,255,255,0.1); border-radius: 20px;">
                    <div style="font-size: 3rem; margin-bottom: 15px;">📭</div>
                    <p style="font-size: 1rem;">Aucune ressource disponible</p>
                </div>
            {% endif %}
        </div>

        <!-- SECTION DICTIONNAIRE (repliable) -->
        <div style="margin-top: 30px; background: rgba(255,255,255,0.1); border-radius: 16px; overflow: hidden; backdrop-filter: blur(4px);">
            <div class="section-toggle" onclick="toggleSection('dictionary-section')" style="display: flex; justify-content: space-between; align-items: center; padding: 15px 25px; background: rgba(0,0,0,0.2); cursor: pointer;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <span style="font-size: 1.3rem;">📖</span>
                    <span style="font-weight: 600;">Dictionnaire</span>
                </div>
                <span id="dictionary-section-icon" style="font-size: 1.2rem;">▼</span>
            </div>
            <div id="dictionary-section" class="section-content" style="display: none; padding: 20px;">
                <div style="display: flex; gap: 12px;">
                    <input type="text" id="dictionary-word" placeholder="Tapez un mot..." style="flex: 1; padding: 10px 15px; border: none; border-radius: 50px; font-size: 0.9rem; outline: none;">
                    <button onclick="searchWord()" style="background: linear-gradient(135deg, #667eea, #764ba2); color: white; border: none; padding: 0 20px; border-radius: 50px; font-size: 0.85rem; font-weight: 600; cursor: pointer;">🔍 Chercher</button>
                </div>
                <div id="dictionary-result" style="margin-top: 15px; padding: 15px; background: rgba(255,255,255,0.95); border-radius: 12px; min-height: 80px;">
                    <p style="color: #94a3b8; text-align: center; font-size: 0.85rem; margin: 10px 0;">Entrez un mot pour voir sa définition</p>
                </div>
                <div style="margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;">
                    <button onclick="setMot('bonjour')" style="background: #e2e8f0; border: none; padding: 4px 14px; border-radius: 50px; cursor: pointer; font-size: 0.75rem;">bonjour</button>
                    <button onclick="setMot('merci')" style="background: #e2e8f0; border: none; padding: 4px 14px; border-radius: 50px; cursor: pointer; font-size: 0.75rem;">merci</button>
                    <button onclick="setMot('amour')" style="background: #e2e8f0; border: none; padding: 4px 14px; border-radius: 50px; cursor: pointer; font-size: 0.75rem;">amour</button>
                </div>
            </div>
        </div>

        <!-- SECTION DIALOGUE VOCAL (repliable) -->
        <div style="margin-top: 15px; background: rgba(255,255,255,0.1); border-radius: 16px; overflow: hidden; backdrop-filter: blur(4px);">
            <div class="section-toggle" onclick="toggleSection('dialogue-section')" style="display: flex; justify-content: space-between; align-items: center; padding: 15px 25px; background: rgba(0,0,0,0.2); cursor: pointer;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <span style="font-size: 1.3rem;">🎤</span>
                    <span style="font-weight: 600;">Pratique la conversation</span>
                </div>
                <span id="dialogue-section-icon" style="font-size: 1.2rem;">▼</span>
            </div>
            <div id="dialogue-section" class="section-content" style="display: none; padding: 20px;">
                <div id="etape-theme">
                    <div style="display: flex; gap: 12px;">
                        <input type="text" id="theme-input" placeholder="Ex: Au restaurant, Voyage..." style="flex: 1; padding: 10px 15px; border: none; border-radius: 50px; font-size: 0.9rem; outline: none;">
                        <button onclick="genererDialogue()" style="background: linear-gradient(135deg, #f97316, #ea580c); color: white; border: none; padding: 0 20px; border-radius: 50px; font-size: 0.85rem; font-weight: 600; cursor: pointer;">Générer</button>
                    </div>
                </div>
                <div id="etape-dialogue" style="display: none; margin-top: 15px;">
                    <div style="margin-bottom: 15px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                            <span style="font-size: 0.8rem;">Progression</span>
                            <span id="score-actuel" style="color: #f97316; font-weight: 600; font-size: 0.8rem;">0%</span>
                        </div>
                        <div style="width: 100%; height: 4px; background: #e2e8f0; border-radius: 2px;">
                            <div id="barre-progression-dialogue" style="width: 0%; height: 100%; background: linear-gradient(90deg, #f97316, #ea580c); border-radius: 2px;"></div>
                        </div>
                    </div>
                    <div style="background: #f8f9fa; border-radius: 12px; padding: 15px;">
                        <div id="dialogue-ia" style="background: #fee2e2; border-radius: 10px; padding: 12px; margin-bottom: 12px;">
                            <div style="display: flex; gap: 8px; margin-bottom: 5px;">
                                <span style="background: #ef4444; color: white; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700;">IA</span>
                                <span style="font-weight: 600; font-size: 0.85rem;">L'IA dit :</span>
                            </div>
                            <p id="texte-ia" style="margin: 0; font-size: 0.9rem; color: #b91c1c;"></p>
                        </div>
                        <div id="dialogue-etudiant" style="background: #dbeafe; border-radius: 10px; padding: 12px; margin-bottom: 12px;">
                            <div style="display: flex; gap: 8px; margin-bottom: 5px;">
                                <span style="background: #3b82f6; color: white; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700;">TOI</span>
                                <span style="font-weight: 600; font-size: 0.85rem;">À ton tour :</span>
                            </div>
                            <p id="texte-etudiant" style="margin: 0; font-size: 0.9rem;"></p>
                        </div>
                    </div>
                    <div style="display: flex; gap: 10px; justify-content: center; margin-top: 15px;">
                        <button id="btn-commencer" onclick="commencerLecture()" style="background: #10b981; color: white; border: none; padding: 8px 20px; border-radius: 50px; font-size: 0.85rem; font-weight: 600; cursor: pointer;">🎤 Commencer</button>
                        <button id="btn-suivant" onclick="passerRepliqueSuivante()" style="display: none; background: #3b82f6; color: white; border: none; padding: 8px 20px; border-radius: 50px; font-size: 0.85rem; font-weight: 600; cursor: pointer;">⏭️ Suivante</button>
                        <button onclick="testerMicrophone()" style="background: #8b5cf6; color: white; border: none; padding: 8px 16px; border-radius: 50px; font-size: 0.75rem; cursor: pointer;">🎤 Tester micro</button>
                    </div>
                    <div id="feedback-correction" style="margin-top: 15px; padding: 12px; border-radius: 10px; display: none;"></div>
                </div>
            </div>
        </div>
        
        <!-- SECTION JEUX ÉDUCATIFS (repliable) -->
        <div style="margin-top: 15px; background: rgba(255,255,255,0.1); border-radius: 16px; overflow: hidden; backdrop-filter: blur(4px);">
            <div class="section-toggle" onclick="toggleSection('games-section')" style="display: flex; justify-content: space-between; align-items: center; padding: 15px 25px; background: rgba(0,0,0,0.2); cursor: pointer;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <span style="font-size: 1.3rem;">🎮</span>
                    <span style="font-weight: 600;">Joue en apprenant</span>
                </div>
                <span id="games-section-icon" style="font-size: 1.2rem;">▼</span>
            </div>
            <div id="games-section" class="section-content" style="display: none; padding: 20px;">
                <div style="display: flex; gap: 10px; margin-bottom: 20px; justify-content: center; flex-wrap: wrap;">
                    <button onclick="choisirJeu('scrambled')" class="jeu-btn" data-jeu="scrambled" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: white; border: none; padding: 8px 20px; border-radius: 50px; font-weight: 600; font-size: 0.8rem; cursor: pointer;">🎯 Phrase Mélangée</button>
                    <button onclick="choisirJeu('oddoneout')" class="jeu-btn" data-jeu="oddoneout" style="background: #f1f5f9; color: #1e293b; border: none; padding: 8px 20px; border-radius: 50px; font-weight: 600; font-size: 0.8rem; cursor: pointer;">🔍 Trouve l'Intrus</button>
                    <button onclick="choisirJeu('crossword')" class="jeu-btn" data-jeu="crossword" style="background: #f1f5f9; color: #1e293b; border: none; padding: 8px 20px; border-radius: 50px; font-weight: 600; font-size: 0.8rem; cursor: pointer;">🧩 Mots Croisés</button>
                </div>
                <div id="zone-jeu" style="min-height: 200px;">
                    <div style="text-align: center; padding: 30px;">
                        <p style="color: #94a3b8;">Choisis un jeu pour commencer !</p>
                    </div>
                </div>
                <div style="margin-top: 15px; display: flex; justify-content: space-between; align-items: center;">
                    <div style="flex: 1; margin-right: 15px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
                            <span style="font-size: 0.7rem;">Progression</span>
                            <span id="progression-jeu" style="font-size: 0.7rem;">0/3</span>
                        </div>
                        <div style="width: 100%; height: 4px; background: #e2e8f0; border-radius: 2px;">
                            <div id="barre-progression-jeu" style="width: 0%; height: 100%; background: linear-gradient(90deg, #8b5cf6, #6366f1); border-radius: 2px;"></div>
                        </div>
                    </div>
                    <div style="background: #fef3c7; padding: 5px 12px; border-radius: 50px;">
                        <span style="color: #92400e; font-weight: 700; font-size: 0.8rem;">⭐ <span id="points-jeu">0</span></span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Bouton terminer -->
        <div style="margin-top: 40px; text-align: center; padding-bottom: 30px;">
            <button onclick="terminerCours({{ cour.id }})" class="btn-terminer" style="background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 14px 50px; font-size: 1rem; font-weight: 700; border-radius: 60px; cursor: pointer; box-shadow: 0 8px 25px rgba(16,185,129,0.3);">
                ✅ Terminer cette leçon
            </button>
        </div>
    </div>

    <script>
        // Fonction pour toggler les sections
        function toggleSection(sectionId) {
            const section = document.getElementById(sectionId);
            const icon = document.getElementById(sectionId + '-icon');
            if (section.style.display === 'none') {
                section.style.display = 'block';
                icon.textContent = '▲';
            } else {
                section.style.display = 'none';
                icon.textContent = '▼';
            }
        }
        
        // Filtrage des ressources
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                const filter = btn.dataset.filter;
                document.querySelectorAll('.ressource-card').forEach(card => {
                    if (filter === 'all' || card.dataset.type === filter) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });
        document.querySelector('[data-filter="all"]').click();
        
        // Terminer le cours
        function terminerCours(coursId) {
            if (confirm("Voulez-vous marquer cette leçon comme terminée ?")) {
                fetch('/cours/' + coursId + '/terminer', {
                    method: 'POST',
                    headers: { 'X-CSRF-Token': '{{ csrf_token('delete' ~ cour.id) }}' }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = '{{ path('app_langue_apprentissage', {id: cour.idNiveau.idLangue.id}) }}';
                    } else {
                        alert("Erreur : " + (data.message || 'Inconnu'));
                    }
                })
                .catch(err => alert("Erreur : " + err.message));
            }
        }
        
        // Dictionnaire
        function setMot(mot) {
            document.getElementById('dictionary-word').value = mot;
            searchWord();
        }
        
        function searchWord() {
            const word = document.getElementById('dictionary-word').value.trim();
            const resultDiv = document.getElementById('dictionary-result');
            if (!word) {
                resultDiv.innerHTML = '<p style="color: #ef4444; text-align: center;">❌ Veuillez entrer un mot</p>';
                return;
            }
            resultDiv.innerHTML = '<p style="text-align: center;">🔍 Recherche...</p>';
            fetch('/api/dictionary/search/' + encodeURIComponent(word))
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        resultDiv.innerHTML = `<p style="color: #ef4444; text-align: center;">❌ ${data.error}</p>`;
                        return;
                    }
                    let html = `<div style="border-bottom: 1px solid #e2e8f0; padding-bottom: 8px; margin-bottom: 12px;">
                                    <h3 style="margin: 0; font-size: 1.2rem; font-weight: 800; color: #1e293b;">${data.word}</h3>
                                </div>`;
                    if (data.definitions && data.definitions.length > 0) {
                        html += '<ul style="margin: 0; padding-left: 20px;">';
                        data.definitions.forEach(def => {
                            html += `<li style="margin-bottom: 5px; color: #475569;">${def}</li>`;
                        });
                        html += '</ul>';
                    }
                    resultDiv.innerHTML = html;
                })
                .catch(error => {
                    resultDiv.innerHTML = `<p style="color: #ef4444; text-align: center;">❌ Erreur</p>`;
                });
        }
        
        // Dialogue vocal (fonctions simplifiées)
        let dialogue = [], indexActuel = 0, reconnaissanceVocale = null, enTrainDeParler = false;
        
        function genererDialogue() {
            const theme = document.getElementById('theme-input').value.trim();
            if (!theme) { alert("Entrez un thème"); return; }
            document.getElementById('etape-theme').style.display = 'none';
            document.getElementById('etape-dialogue').style.display = 'block';
            fetch('/dialogue/generer', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    theme: theme,
                    niveau: '{{ cour.idNiveau.difficulte }}',
                    langue: '{{ cour.idNiveau.idLangue.nom }}'
                })
            })
            .then(response => response.json())
            .then(data => {
                dialogue = data.dialogue;
                indexActuel = 0;
                afficherReplique();
            })
            .catch(error => { alert('Erreur'); });
        }
        
        function afficherReplique() {
            if (indexActuel >= dialogue.length) {
                document.getElementById('feedback-correction').innerHTML = '<div style="background:#10b981;padding:15px;border-radius:10px;"><h4>Félicitations !</h4><p>Tu as terminé la conversation !</p><button onclick="recommencer()" style="background:white;color:#10b981;border:none;padding:10px 20px;border-radius:50px;">🔄 Recommencer</button></div>';
                return;
            }
            const replique = dialogue[indexActuel];
            const progress = ((indexActuel + 1) / dialogue.length * 100);
            document.getElementById('barre-progression-dialogue').style.width = progress + '%';
            document.getElementById('score-actuel').textContent = Math.round(progress) + '%';
            if (replique.role === 'ia') {
                document.getElementById('dialogue-ia').style.display = 'block';
                document.getElementById('dialogue-etudiant').style.display = 'none';
                document.getElementById('texte-ia').textContent = replique.texte;
                document.getElementById('btn-commencer').style.display = 'none';
                document.getElementById('btn-suivant').style.display = 'none';
                lireTexteIA(replique.texte);
            } else {
                document.getElementById('dialogue-ia').style.display = 'none';
                document.getElementById('dialogue-etudiant').style.display = 'block';
                document.getElementById('texte-etudiant').textContent = replique.texte;
                document.getElementById('btn-commencer').style.display = 'inline-block';
                document.getElementById('btn-suivant').style.display = 'none';
                document.getElementById('feedback-correction').style.display = 'none';
            }
        }
        
        function lireTexteIA(texte) {
            const utterance = new SpeechSynthesisUtterance(texte);
            utterance.lang = '{{ cour.idNiveau.idLangue.nom }}' === 'Anglais' ? 'en-US' : 'fr-FR';
            utterance.onend = () => { indexActuel++; afficherReplique(); };
            window.speechSynthesis.speak(utterance);
        }
        
        function commencerLecture() {
            if (!('webkitSpeechRecognition' in window)) { alert("Reconnaissance non supportée"); return; }
            reconnaissanceVocale = new webkitSpeechRecognition();
            reconnaissanceVocale.lang = '{{ cour.idNiveau.idLangue.nom }}' === 'Anglais' ? 'en-US' : 'fr-FR';
            reconnaissanceVocale.onresult = (event) => {
                const parole = event.results[0][0].transcript;
                verifierPrononciation(parole);
            };
            reconnaissanceVocale.start();
            document.getElementById('feedback-correction').innerHTML = '<p style="background:#f3f4f6;padding:15px;border-radius:10px;">🎤 Parle maintenant...</p>';
            document.getElementById('feedback-correction').style.display = 'block';
            document.getElementById('btn-commencer').style.display = 'none';
        }
        
        function verifierPrononciation(parole) {
            const attendu = document.getElementById('texte-etudiant').textContent;
            const score = attendu.toLowerCase() === parole.toLowerCase() ? 100 : 50;
            document.getElementById('score-actuel').textContent = score + '%';
            document.getElementById('feedback-correction').innerHTML = `<div style="background:${score === 100 ? '#10b981' : '#fee2e2'};padding:15px;border-radius:10px;"><h4>${score === 100 ? '✅ Parfait !' : '📝 Continue'}</h4><p>Tu as dit : "${parole}"</p><p>Score: ${score}%</p></div>`;
            document.getElementById('btn-suivant').style.display = 'inline-block';
        }
        
        function passerRepliqueSuivante() {
            indexActuel++;
            afficherReplique();
        }
        
        function testerMicrophone() {
            navigator.mediaDevices.getUserMedia({ audio: true })
                .then(stream => { stream.getTracks().forEach(track => track.stop()); alert("✅ Microphone fonctionnel !"); })
                .catch(() => alert("❌ Microphone non accessible"));
        }
        
        function recommencer() {
            document.getElementById('etape-theme').style.display = 'block';
            document.getElementById('etape-dialogue').style.display = 'none';
            document.getElementById('theme-input').value = '';
            document.getElementById('score-actuel').textContent = '0%';
        }
        
        // Jeux éducatifs (fonctions simplifiées)
        let typeJeuActuel = 'scrambled', motsSelectionnes = [], jeuActuel = null;
        
        function choisirJeu(type) {
            typeJeuActuel = type;
            chargerJeu();
        }
        
        function chargerJeu() {
            document.getElementById('zone-jeu').innerHTML = '<p style="text-align:center;">🎲 Chargement...</p>';
            fetch('/jeu/generer', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    type: typeJeuActuel,
                    niveau: '{{ cour.idNiveau.difficulte }}',
                    langue: '{{ cour.idNiveau.idLangue.nom }}',
                    theme: 'général'
                })
            })
            .then(response => response.json())
            .then(data => { jeuActuel = data; afficherJeu(data); })
            .catch(error => { document.getElementById('zone-jeu').innerHTML = '<p style="color:#ef4444;">❌ Erreur</p>'; });
        }
        
        function afficherJeu(jeu) {
            if (jeu.type === 'scrambled') {
                motsSelectionnes = [];
                let html = `<h3 style="color:#333;margin-bottom:20px;">Remets les mots dans l'ordre</h3>
                    <div style="background:#f8f9fa;padding:20px;border-radius:15px;margin-bottom:20px;">
                        <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;" id="mots-melange">`;
                jeu.scrambled.forEach((mot, i) => {
                    html += `<span onclick="selectionnerMot('${mot}', this)" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:white;padding:12px 20px;border-radius:50px;cursor:pointer;">${mot}</span>`;
                });
                html += `</div></div>
                    <div style="background:#e9f0ff;padding:20px;border-radius:15px;margin-bottom:20px;">
                        <p><strong>Ta phrase :</strong></p>
                        <div id="phrase-utilisateur" style="min-height:50px;background:white;border-radius:10px;padding:15px;"></div>
                    </div>
                    <button onclick="verifierScrambled()" style="background:#10b981;color:white;border:none;padding:12px 30px;border-radius:50px;cursor:pointer;">✅ Vérifier</button>`;
                document.getElementById('zone-jeu').innerHTML = html;
            } else if (jeu.type === 'oddoneout') {
                let html = `<h3 style="color:#333;margin-bottom:20px;">Trouve l'intrus</h3>
                    <p style="margin-bottom:20px;">${jeu.explanation}</p>
                    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:15px;max-width:400px;margin:0 auto;">`;
                jeu.words.forEach(mot => {
                    html += `<div onclick="verifierIntrus('${mot}', '${jeu.intruder}', this)" style="background:#dbeafe;padding:20px;border-radius:15px;cursor:pointer;text-align:center;border:2px solid #3b82f6;"><p style="font-size:1.5rem;font-weight:bold;margin:0;">${mot}</p></div>`;
                });
                html += `</div>`;
                document.getElementById('zone-jeu').innerHTML = html;
            } else {
                document.getElementById('zone-jeu').innerHTML = '<p style="text-align:center;">Jeu en cours de développement</p>';
            }
        }
        
        function selectionnerMot(mot, element) {
            motsSelectionnes.push(mot);
            document.getElementById('phrase-utilisateur').innerHTML += `<span style="background:#3b82f6;color:white;padding:5px 15px;border-radius:50px;margin:5px;display:inline-block;">${mot}</span>`;
            element.style.opacity = '0.5';
            element.style.pointerEvents = 'none';
        }
        
        function verifierScrambled() {
            const reponse = motsSelectionnes.join(' ');
            fetch('/jeu/verifier', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ type: 'scrambled', reponse: reponse })
            })
            .then(response => response.json())
            .then(data => {
                if (data.correct) {
                    alert('🎉 Bravo !');
                    mettreAJourProgressionJeu();
                    chargerJeu();
                } else {
                    alert('❌ Essaie encore !');
                }
            });
        }
        
        function verifierIntrus(mot, intrus, element) {
            if (mot === intrus) {
                element.style.background = '#10b981';
                alert('🎉 Bravo ! C\'est l\'intrus !');
                mettreAJourProgressionJeu();
                chargerJeu();
            } else {
                element.style.background = '#fee2e2';
                alert('❌ Ce n\'est pas l\'intrus');
                setTimeout(() => { element.style.background = '#dbeafe'; }, 500);
            }
        }
        
        function mettreAJourProgressionJeu() {
            let points = parseInt(document.getElementById('points-jeu').textContent) || 0;
            points += 10;
            document.getElementById('points-jeu').textContent = points;
            let progression = document.getElementById('barre-progression-jeu');
            let currentWidth = parseInt(progression.style.width) || 0;
            let newWidth = Math.min(currentWidth + 33.33, 100);
            progression.style.width = newWidth + '%';
            document.getElementById('progression-jeu').textContent = Math.round(newWidth/33.33) + '/3';
        }
    </script>
</div>
{% endblock %}