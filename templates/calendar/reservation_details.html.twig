{% extends 'base.html.twig' %}

{% block title %}Réservation #{{ reservation.id }} - Fluently Live{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center py-4">
                    <h2 class="mb-0">Réservation Confirmée !</h2>
                    <p class="mb-0">Merci d'avoir réservé avec Fluently Live</p>
                </div>

                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <h4>Réservation #{{ reservation.id }}</h4>
                        <p class="lead">
                            {{ session.group.nom ?? 'Groupe' }} — {{ session.group.idNiveau.titre ?? 'Niveau' }}
                        </p>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="info-box p-4 bg-light rounded">
                                <h5>Date & Heure</h5>
                                <p class="fs-5 fw-bold">
                                    {{ session.dateHeure ? session.dateHeure|date('d/m/Y à H:i') : '—' }}
                                </p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-box p-4 bg-light rounded">
                                <h5>Formateur</h5>
                                <p class="fs-5 fw-bold">
                                    {% if session.user %}
                                        {{ session.user.prenom }} {{ session.user.nom }}
                                    {% else %}
                                        Non défini
                                    {% endif %}
                                </p>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="info-box p-4 bg-light rounded">
                                <h5>Lien de réunion</h5>
                                {% if session.lienReunion %}
                                    <a href="{{ session.lienReunion }}" target="_blank" class="btn btn-primary btn-lg w-100">
                                        Rejoindre la session <i class="fas fa-external-link-alt ms-2"></i>
                                    </a>
                                {% else %}
                                    <p class="text-muted">Lien disponible prochainement</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <!-- QR Code -->
                    <div class="text-center mt-5">
                        <h5>Votre QR Code de confirmation</h5>
                        <img src="{{ path('app_calendar_qrcode', {'id': reservation.id}) }}" alt="QR Code" class="img-fluid shadow" style="max-width: 300px;">
                        <p class="mt-3 text-muted">Présentez ce QR code le jour de la session</p>
                    </div>
                </div>

                <div class="card-footer text-center py-4">
                    <a href="{{ path('app_calendar_index') }}" class="btn btn-outline-primary btn-lg px-5">
                        Retour au calendrier
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .info-box {
        border-left: 5px solid #6C3CE1;
    }
    .card-header {
        background: linear-gradient(135deg, #00C853, #00b33c);
    }
</style>
{% endblock %}