{% extends 'base.html.twig' %}
{% block title %}Calendrier Fluently Live{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<script>
(function() {
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js';
    s.onload = function() { window._fcReady = true; if (window._fcCallback) window._fcCallback(); };
    document.head.appendChild(s);
})();
</script>

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body,html{background:#0F0F1A!important;color:#E8E8F0!important;font-family:'Outfit',sans-serif!important}
.navbar,nav,header{display:none!important}
.container,.container-fluid,main,#main-content,#content,#app,.wrapper{padding:0!important;margin:0!important;max-width:100%!important;background:#0F0F1A!important}

.cal-wrapper{min-height:100vh;padding:2rem;background:linear-gradient(135deg,#0F0F1A 0%,#1A1A2E 50%,#16213E 100%)}
.page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;flex-wrap:wrap;gap:1rem}
.page-title{font-size:2rem;font-weight:800;background:linear-gradient(90deg,#6C3CE1,#00D4FF);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.page-sub{font-size:.85rem;color:#6B6B8A;margin-top:.25rem}

/* Stats */
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem}
@media(max-width:900px){.stats-row{grid-template-columns:repeat(2,1fr)}}
@media(max-width:500px){.stats-row{grid-template-columns:1fr}}
.stat-card{background:#1A1A2E;border:1px solid rgba(255,255,255,.06);border-radius:14px;padding:1.25rem;display:flex;align-items:center;gap:1rem;transition:transform .2s,border-color .2s}
.stat-card:hover{transform:translateY(-3px);border-color:rgba(108,60,225,.4)}
.stat-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0}
.si-purple{background:rgba(108,60,225,.2)}.si-green{background:rgba(0,230,118,.2)}.si-cyan{background:rgba(0,212,255,.2)}.si-yellow{background:rgba(255,214,0,.2)}
.stat-value{font-size:1.8rem;font-weight:800;color:#E8E8F0;line-height:1}
.stat-label{font-size:.78rem;color:#6B6B8A;margin-top:4px}

/* Progression */
.prog-panel{background:linear-gradient(135deg,rgba(0,212,255,.08),rgba(108,60,225,.08));border:1px solid rgba(0,212,255,.2);border-radius:16px;padding:1.5rem;margin-bottom:1.5rem}
.prog-header{display:flex;align-items:center;gap:.75rem;margin-bottom:1rem}
.prog-emoji{font-size:1.6rem}
.prog-title{font-weight:700;font-size:1rem;color:#E8E8F0}
.prog-sub{font-size:.75rem;color:#6B6B8A;margin-top:2px}
.prog-bars{display:flex;flex-direction:column;gap:.65rem}
.prog-item{display:flex;align-items:center;gap:.75rem}
.prog-lbl{font-size:.75rem;color:#9E9EBB;min-width:120px}
.prog-bg{flex:1;background:rgba(255,255,255,.05);border-radius:4px;height:8px;overflow:hidden}
.prog-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,#6C3CE1,#00D4FF);transition:width 1.2s cubic-bezier(.4,0,.2,1);width:0%}
.prog-cnt{font-size:.72rem;color:#00D4FF;font-weight:700;min-width:28px;text-align:right}
.prog-rec{margin-top:1rem;padding:.85rem 1rem;background:rgba(108,60,225,.12);border-left:3px solid #6C3CE1;border-radius:0 10px 10px 0;font-size:.85rem;color:#b59fff;line-height:1.6;display:none}

/* Luna IA */
.ai-panel{background:linear-gradient(135deg,rgba(108,60,225,.15),rgba(0,212,255,.08));border:1px solid rgba(108,60,225,.35);border-radius:16px;padding:1.5rem;margin-bottom:1.5rem;position:relative;overflow:hidden}
.ai-panel::before{content:'';position:absolute;top:-60%;right:-5%;width:220px;height:220px;background:radial-gradient(circle,rgba(108,60,225,.15),transparent);border-radius:50%;pointer-events:none}
.ai-header{display:flex;align-items:center;gap:.85rem;margin-bottom:1.1rem}
.ai-avatar{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#6C3CE1,#00D4FF);display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0;box-shadow:0 4px 15px rgba(108,60,225,.4)}
.ai-title{font-weight:700;font-size:1rem;color:#E8E8F0}
.ai-sub{font-size:.75rem;color:#6B6B8A;margin-top:2px}
.ai-row{display:flex;gap:.75rem;align-items:stretch}
.ai-input{flex:1;background:rgba(255,255,255,.05);border:1px solid rgba(108,60,225,.3);border-radius:10px;padding:.8rem 1rem;color:#E8E8F0;font-size:.9rem;outline:none;font-family:'Outfit',sans-serif;transition:border-color .2s,background .2s}
.ai-input:focus{border-color:#6C3CE1;background:rgba(108,60,225,.1)}
.ai-input::placeholder{color:#6B6B8A}
.btn-ai{background:linear-gradient(135deg,#6C3CE1,#00D4FF);border:none;border-radius:10px;padding:.8rem 1.4rem;color:white;font-weight:700;cursor:pointer;white-space:nowrap;font-family:'Outfit',sans-serif;font-size:.9rem;transition:transform .2s,box-shadow .2s}
.btn-ai:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(108,60,225,.45)}
.btn-ai:disabled{opacity:.6;cursor:not-allowed;transform:none}
.ai-resp{margin-top:1rem;padding:1rem 1.1rem;background:rgba(0,212,255,.06);border-left:3px solid #00D4FF;border-radius:0 10px 10px 0;font-size:.9rem;line-height:1.7;color:#E8E8F0;display:none}

/* Calendrier */
.cal-card{background:#1A1A2E;border:1px solid rgba(255,255,255,.06);border-radius:20px;padding:1.5rem;margin-bottom:1.5rem}
#calendar{min-height:500px}
.fc{--fc-border-color:rgba(255,255,255,.07);--fc-button-bg-color:#6C3CE1;--fc-button-border-color:#6C3CE1;--fc-button-hover-bg-color:#5530c5;--fc-button-active-bg-color:#4420b5;--fc-today-bg-color:rgba(108,60,225,.12);--fc-page-bg-color:transparent;color:#E8E8F0}
.fc .fc-toolbar-title{font-size:1.3rem;font-weight:700;color:#E8E8F0}
.fc .fc-col-header-cell-cushion,.fc .fc-daygrid-day-number{color:#E8E8F0;text-decoration:none}
.fc-theme-standard td,.fc-theme-standard th{border-color:rgba(255,255,255,.07)}
.fc-theme-standard .fc-scrollgrid{border-color:rgba(255,255,255,.07)}
.fc .fc-event{border:none;border-radius:6px;font-size:.78rem;font-weight:600;padding:2px 6px;cursor:pointer;transition:opacity .15s}
.fc .fc-event:hover{opacity:.85}
.fc .fc-button{font-family:'Outfit',sans-serif;font-weight:600;border-radius:8px}
.legend{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,.05)}
.legend-item{display:flex;align-items:center;gap:.4rem;font-size:.78rem;color:#6B6B8A}
.legend-dot{width:10px;height:10px;border-radius:3px;flex-shrink:0}

/* Overlay */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.8);backdrop-filter:blur(6px);z-index:99999;display:none;align-items:center;justify-content:center;padding:1rem}
.overlay.open{display:flex}

/* Modal session */
.s-modal{background:linear-gradient(160deg,#1A1A2E,#16213E);border:1px solid rgba(108,60,225,.35);border-radius:20px;padding:2rem;width:100%;max-width:520px;position:relative;animation:slideUp .3s ease;z-index:100000;max-height:90vh;overflow-y:auto}
.m-close{position:absolute;top:1rem;right:1rem;background:rgba(255,255,255,.08);border:none;width:34px;height:34px;border-radius:8px;color:#E8E8F0;cursor:pointer;font-size:1rem;display:flex;align-items:center;justify-content:center;transition:background .2s}
.m-close:hover{background:#FF4757}
.m-title{font-size:1.25rem;font-weight:800;margin-bottom:1rem;color:#E8E8F0;padding-right:2.5rem;line-height:1.3}
.mbadge{display:inline-block;padding:4px 12px;border-radius:20px;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1rem}
.b-plan{background:rgba(108,60,225,.2);color:#b59fff;border:1px solid rgba(108,60,225,.4)}
.b-enc{background:rgba(0,230,118,.15);color:#00E676;border:1px solid rgba(0,230,118,.3)}
.b-ter{background:rgba(107,107,138,.2);color:#9E9EBB;border:1px solid rgba(107,107,138,.3)}
.b-ann{background:rgba(255,71,87,.15);color:#FF4757;border:1px solid rgba(255,71,87,.3)}
.m-row{display:flex;align-items:flex-start;gap:.85rem;padding:.85rem 0;border-bottom:1px solid rgba(255,255,255,.05)}
.m-row:last-of-type{border-bottom:none}
.m-ico{font-size:1.15rem;margin-top:1px;flex-shrink:0;width:24px;text-align:center}
.m-lbl{font-size:.72rem;color:#6B6B8A;margin-bottom:3px}
.m-val{font-size:.92rem;font-weight:600;color:#E8E8F0}
.m-actions{display:flex;gap:.75rem;margin-top:1.5rem;flex-wrap:wrap}
.btn-reserve{flex:1;min-width:140px;background:linear-gradient(135deg,#6C3CE1,#00D4FF);border:none;border-radius:10px;padding:.9rem 1.5rem;color:white;font-weight:700;font-size:.92rem;cursor:pointer;font-family:'Outfit',sans-serif;transition:transform .2s,box-shadow .2s}
.btn-reserve:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(108,60,225,.45)}
.btn-reserve:disabled{background:rgba(107,107,138,.4);color:#6B6B8A;cursor:not-allowed;transform:none;box-shadow:none}
.btn-qr-exist{flex:1;min-width:140px;background:rgba(0,212,255,.12);border:1px solid rgba(0,212,255,.4);border-radius:10px;padding:.9rem 1.5rem;color:#00D4FF;font-weight:700;font-size:.92rem;cursor:pointer;font-family:'Outfit',sans-serif;transition:background .2s}
.btn-qr-exist:hover{background:rgba(0,212,255,.22)}
.btn-join{flex:1;min-width:140px;background:rgba(0,230,118,.12);border:1px solid rgba(0,230,118,.4);border-radius:10px;padding:.9rem 1.5rem;color:#00E676;font-weight:700;font-size:.92rem;text-decoration:none;text-align:center;transition:background .2s}
.btn-join:hover{background:rgba(0,230,118,.2)}
.places-warn{color:#FF4757!important}

/* Modal QR */
.qr-modal{background:linear-gradient(160deg,#1A1A2E,#16213E);border:1px solid rgba(0,212,255,.35);border-radius:20px;padding:2rem;width:100%;max-width:460px;text-align:center;animation:slideUp .3s ease;z-index:100000;max-height:90vh;overflow-y:auto}
.qr-header{margin-bottom:1.5rem}
.qr-emoji{font-size:2.5rem;margin-bottom:.5rem}
.qr-title{font-size:1.4rem;font-weight:800;color:#E8E8F0;margin-bottom:.4rem}
.qr-sub{font-size:.82rem;color:#6B6B8A}
.qr-img-wrap{background:white;border-radius:16px;padding:1rem;display:inline-block;margin-bottom:1.25rem;box-shadow:0 0 0 4px rgba(108,60,225,.3),0 8px 30px rgba(0,0,0,.4)}
#qr-img{width:240px;height:240px;display:block;border-radius:8px;object-fit:contain}
.qr-info{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:.85rem 1rem;font-size:.76rem;color:#6B6B8A;text-align:left;margin-bottom:1.25rem;white-space:pre-wrap;line-height:1.7;font-family:'Courier New',monospace}
.qr-actions{display:flex;flex-direction:column;gap:.6rem}
/* Modal Calendrier */
.cal-modal{background:linear-gradient(160deg,#1A1A2E,#16213E);border:1px solid rgba(108,60,225,.35);border-radius:20px;padding:2rem;width:100%;max-width:1000px;animation:slideUp .3s ease;z-index:100000;max-height:90vh;overflow-y:auto;position:relative}
.cal-modal-header{margin-bottom:1.5rem;text-align:center}
.cal-modal-header h2{font-size:1.5rem;font-weight:800;color:#E8E8F0;margin-bottom:.5rem}
.cal-modal-header p{font-size:.9rem;color:#6B6B8A}
.cal-modal-actions{display:flex;justify-content:center;gap:1rem;margin-top:1.5rem}
.btn-gcal{width:100%;background:white;color:#333;border:none;border-radius:10px;padding:.9rem;font-weight:700;cursor:pointer;font-size:.9rem;display:flex;align-items:center;justify-content:center;gap:.6rem;font-family:'Outfit',sans-serif;transition:transform .2s,box-shadow .2s}
.btn-gcal:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.25)}
.btn-gcal:disabled{opacity:.6;cursor:not-allowed;transform:none}
.btn-dl{width:100%;background:rgba(108,60,225,.15);border:1px solid rgba(108,60,225,.35);border-radius:10px;padding:.9rem;color:#b59fff;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;font-size:.9rem;transition:background .2s;text-decoration:none;display:block}
.btn-dl:hover{background:rgba(108,60,225,.25)}
.btn-close-qr{width:100%;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:.8rem;color:#9E9EBB;cursor:pointer;font-family:'Outfit',sans-serif;font-size:.88rem;transition:background .2s}
.btn-close-qr:hover{background:rgba(255,255,255,.1)}

/* Toasts */
.toasts{position:fixed;bottom:2rem;right:2rem;z-index:999999;display:flex;flex-direction:column;gap:.5rem;pointer-events:none}
.toast{background:#1A1A2E;border-left:4px solid #6C3CE1;border-radius:10px;padding:.9rem 1.25rem;min-width:290px;max-width:420px;box-shadow:0 8px 30px rgba(0,0,0,.5);font-size:.875rem;color:#E8E8F0;animation:slideInR .3s ease;pointer-events:all;word-break:break-word}
.toast.ok{border-color:#00E676}.toast.err{border-color:#FF4757}.toast.warn{border-color:#FFD600}

/* Spinner */
.spin{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:white;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;margin-right:6px}

@keyframes spin{to{transform:rotate(360deg)}}
@keyframes slideUp{from{transform:translateY(30px);opacity:0}to{transform:translateY(0);opacity:1}}
@keyframes slideInR{from{transform:translateX(110%);opacity:0}to{transform:translateX(0);opacity:1}}
</style>

<div class="cal-wrapper">
    <div class="page-header">
        <div>
            <h1 class="page-title">🎓 Calendrier Fluently Live</h1>
            <div class="page-sub">Sessions • Réservations • IA • Google Calendar</div>
        </div>
    </div>

    <div class="stats-row">
        <div class="stat-card"><div class="stat-icon si-purple">📅</div><div><div class="stat-value" id="s-total">–</div><div class="stat-label">Sessions totales</div></div></div>
        <div class="stat-card"><div class="stat-icon si-green">✅</div><div><div class="stat-value" id="s-enc">–</div><div class="stat-label">En cours</div></div></div>
        <div class="stat-card"><div class="stat-icon si-cyan">🔮</div><div><div class="stat-value" id="s-plan">–</div><div class="stat-label">Planifiées</div></div></div>
        <div class="stat-card"><div class="stat-icon si-yellow">🎟️</div><div><div class="stat-value" id="s-resa">–</div><div class="stat-label">Réservations</div></div></div>
    </div>

    <div class="prog-panel">
        <div class="prog-header">
            <div class="prog-emoji">📊</div>
            <div><div class="prog-title">Analyse de progression — LUNA IA</div><div class="prog-sub">Basé sur les réservations enregistrées</div></div>
        </div>
        <div class="prog-bars" id="prog-bars"><div style="color:#6B6B8A;font-size:.82rem;">Chargement...</div></div>
        <div class="prog-rec" id="prog-rec"></div>
    </div>

    <div class="ai-panel">
        <div class="ai-header">
            <div class="ai-avatar">🌙</div>
            <div><div class="ai-title">LUNA — Assistante IA Fluently</div><div class="ai-sub">Je recommande des sessions selon votre niveau et vos objectifs</div></div>
