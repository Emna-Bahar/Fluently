</div>

{# MODAL CALENDRIER MES RÉSERVATIONS #}
<div class="overlay" id="modal-my-reservations">
    <div class="cal-modal">
        <button class="m-close" onclick="closeMyReservationsCalendar()">✕</button>
        <div class="cal-modal-header">
            <h2>📅 Mes Réservations</h2>
            <p>Calendrier de vos réservations confirmées</p>
        </div>
        <div id="my-reservations-calendar" style="height: 550px;"></div>
        <div class="cal-modal-actions">
            <button class="btn-close-qr" onclick="closeMyReservationsCalendar()">Fermer</button>
        </div>
    </div>
</div>

<div class="toasts" id="toasts"></div>

<script>
'use strict';

let currentResaId = null;
let googleToken   = null;
const GOOGLE_CID  = 'YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com';

/* ── INIT ── */
function startApp() {
    loadStats();
    loadProgression();
    initCalendar();
}

if (window._fcReady) {
    document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', startApp) : startApp();
} else {
    window._fcCallback = startApp;
}

/* ── UTILS ── */
function normalizeStatut(str) {
    return (str || '').toLowerCase()
        .replace(/[éèê]/g,'e').replace(/[àâ]/g,'a').replace(/[ùû]/g,'u')
        .replace(/[îï]/g,'i').replace(/[ôö]/g,'o').replace(/\s+/g,'_').trim();
}

function esc(str) {
    if (typeof str !== 'string') return str ?? '';
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
}

/* ── STATS ── */
async function loadStats() {
    try {
        const r  = await fetch('/calendar/stats');
        const ct = r.headers.get('content-type') || '';
        if (!ct.includes('application/json')) throw new Error('Non-JSON');
        const d  = await r.json();
        document.getElementById('s-total').textContent = d.total        ?? '–';
        document.getElementById('s-enc').textContent   = d.en_cours     ?? '–';
        document.getElementById('s-plan').textContent  = d.planifie     ?? '–';
        document.getElementById('s-resa').textContent  = d.reservations ?? '–';
    } catch(e) { console.error('Stats:', e); }
}

/* ── PROGRESSION ── */
async function loadProgression() {
    const bars = document.getElementById('prog-bars');
    const rec  = document.getElementById('prog-rec');
    try {
        const r  = await fetch('/calendar/ai-progression');
        const ct = r.headers.get('content-type') || '';
        if (!ct.includes('application/json')) throw new Error('Non-JSON');
        const d  = await r.json();

        if (!d.stats || d.stats.length === 0) {
            bars.innerHTML = '<div style="color:#6B6B8A;font-size:.82rem;">Aucune réservation. Commencez par réserver une session ! 🌟</div>';
            return;
        }
        const max = Math.max(...d.stats.map(s => s.count), 1);
        bars.innerHTML = d.stats.slice(0,6).map(s => {
            const pct = Math.round((s.count/max)*100);
            return `<div class="prog-item">
                <div class="prog-lbl">${esc(s.langue)} • ${esc(s.niveau)}</div>
                <div class="prog-bg"><div class="prog-fill" data-w="${pct}%"></div></div>
                <div class="prog-cnt">${s.count}</div>
            </div>`;
        }).join('');
        setTimeout(() => bars.querySelectorAll('.prog-fill').forEach(b => b.style.width = b.dataset.w), 120);
        if (d.recommendation) { rec.textContent = '🤖 '+d.recommendation; rec.style.display='block'; }
    } catch(e) { console.error('Progression:', e); bars.innerHTML = '<div style="color:#FF4757;font-size:.82rem;">Erreur de chargement.</div>'; }
}

/* ── FULLCALENDAR ── */
function initCalendar() {
    const el = document.getElementById('calendar');
    if (!el || typeof FullCalendar === 'undefined') {
        if(el) el.innerHTML = '<p style="color:#FF4757;text-align:center;padding:3rem;">❌ FullCalendar non chargé.</p>';
        return;
    }
    const cal = new FullCalendar.Calendar(el, {
        initialView: 'dayGridMonth',
        locale: 'fr',
        headerToolbar: { left:'prev,next today', center:'title', right:'dayGridMonth,timeGridWeek,timeGridDay' },
        buttonText: { today:"Aujourd'hui", month:'Mois', week:'Semaine', day:'Jour' },
        events: '/calendar/events',
        editable: false, selectable: false, height: 'auto',
        eventClick: function(info) { openModal(info.event); },
        eventDidMount: function(info) {
            const p = info.event.extendedProps;
            info.el.title = `${info.event.title}\n${p.places_restantes ?? '?'} place(s) restante(s)`;
        }
    });
    cal.render();
}

/* ── MODAL SESSION ── */
function openModal(event) {
    const p      = event.extendedProps;
    const statut = normalizeStatut(p.statut || 'planifiee');

    document.getElementById('m-title').textContent = event.title;

    const BADGES = {
        planifiee: ['b-plan','📅 Planifiée'],
        en_cours:  ['b-enc', '🟢 En cours'],
        terminee:  ['b-ter', '✅ Terminée'],
        annulee:   ['b-ann', '❌ Annulée'],
    };
    const [cls, lbl] = BADGES[statut] || ['b-plan', p.statut_label || statut];
    document.getElementById('m-badge').innerHTML = `<span class="mbadge ${cls}">${lbl}</span>`;

    const dateStr = event.start
        ? event.start.toLocaleString('fr-FR',{weekday:'long',year:'numeric',month:'long',day:'numeric',hour:'2-digit',minute:'2-digit'})
        : '–';

    const places    = p.places_restantes ?? '?';
    const cap       = p.capacite ?? '?';
    const placesCls = (typeof places === 'number' && places <= 2) ? 'places-warn' : '';

    document.getElementById('m-body').innerHTML = `
        <div class="m-row"><div class="m-ico">📅</div><div><div class="m-lbl">Date & heure</div><div class="m-val">${esc(dateStr)}</div></div></div>
        <div class="m-row"><div class="m-ico">👥</div><div><div class="m-lbl">Groupe</div><div class="m-val">${esc(p.groupe||'–')}</div></div></div>
        <div class="m-row"><div class="m-ico">🌍</div><div><div class="m-lbl">Langue / Niveau</div><div class="m-val">${esc(p.langue||'–')} • ${esc(p.niveau||'–')}</div></div></div>
        <div class="m-row"><div class="m-ico">🎓</div><div><div class="m-lbl">Formateur</div><div class="m-val">${esc(p.formateur||'–')}</div></div></div>
        <div class="m-row"><div class="m-ico">💺</div><div><div class="m-lbl">Places disponibles</div><div class="m-val ${placesCls}">${places} / ${cap}</div></div></div>
        ${p.lien_reunion ? `<div class="m-row"><div class="m-ico">🔗</div><div><div class="m-lbl">Lien réunion</div><div class="m-val"><a href="${esc(p.lien_reunion)}" target="_blank" style="color:#00D4FF;text-decoration:none;">Ouvrir ↗</a></div></div></div>` : ''}
    `;

    const actions = document.getElementById('m-actions');
    actions.innerHTML = '';

    if (statut === 'planifiee') {
        if (p.deja_reserve) {
            actions.innerHTML += `<button class="btn-qr-exist" onclick="recupererQr(${p.session_id}, this)">🎟️ Voir mon QR code</button>`;
        } else if (typeof places === 'number' && places <= 0) {
            actions.innerHTML += `<button class="btn-reserve" disabled>❌ Session complète</button>`;
        } else {
            actions.innerHTML += `<button class="btn-reserve" id="btn-res" onclick="reserver(${p.session_id})">🎟️ Réserver cette session</button>`;
        }
    } else if (statut === 'en_cours') {
        actions.innerHTML += `<button class="btn-reserve" disabled>Session en cours</button>`;
        if (p.lien_reunion) {
            actions.innerHTML += `<a href="${esc(p.lien_reunion)}" target="_blank" class="btn-join">📹 Rejoindre</a>`;
        }
    } else {
        actions.innerHTML += `<button class="btn-reserve" disabled>Non disponible</button>`;
    }

    document.getElementById('modal-session').classList.add('open');
}

function closeModal() { document.getElementById('modal-session').classList.remove('open'); }
document.getElementById('modal-session').addEventListener('click', e => { if(e.target.id==='modal-session') closeModal(); });

/* ── RÉSERVATION ── */
async function reserver(sessionId) {
    const btn = document.getElementById('btn-res');
    if (!btn || btn.disabled) return;
    btn.disabled  = true;
    btn.innerHTML = '<span class="spin"></span>Réservation en cours...';

    try {
        const r  = await fetch(`/calendar/reserver/${sessionId}`, {
            method: 'POST',
            headers: { 'X-Requested-With':'XMLHttpRequest', 'Content-Type':'application/json' }
        });
        const ct = r.headers.get('content-type') || '';
        if (!ct.includes('application/json')) {
            const html = await r.text();
            console.error('Réponse non-JSON:', html.substring(0, 800));
            throw new Error('Erreur serveur. Vérifiez les logs Symfony.');
        }
        const d = await r.json();
        if (d.success) {
            currentResaId = d.reservation_id;
            closeModal();
            loadStats();
            loadProgression();
            if (d.qr_code) {
                openQr(d.qr_code, d.qr_content || '', d.already_reserved || false);
                toast(d.already_reserved ? 'ℹ️ Déjà réservé — voici votre QR code' : '✅ Réservation confirmée !', d.already_reserved ? 'warn' : 'ok');
            } else {
                toast('⚠️ ' + (d.message || 'QR code indisponible'), 'warn');
            }
        } else {
            toast('❌ ' + (d.message || 'Erreur inconnue'), 'err');
            if(btn) { btn.disabled = false; btn.innerHTML = '🎟️ Réserver cette session'; }
        }
    } catch(e) {
        console.error('Erreur reserver:', e);
        toast('❌ ' + e.message, 'err');
        if(btn) { btn.disabled = false; btn.innerHTML = '🎟️ Réserver cette session'; }
    }
}

/* ── RÉCUPÉRER QR EXISTANT ── */
async function recupererQr(sessionId, btnElement) {
    const originalText = btnElement ? btnElement.innerHTML : '🎟️ Voir mon QR code';
    if (btnElement) {
        btnElement.disabled = true;
        btnElement.innerHTML = '<span class="spin"></span> Chargement...';
    }

    try {
        const response = await fetch(`/calendar/reserver/${sessionId}`, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/json' }
        });

        const contentType = response.headers.get('content-type') || '';
        if (!contentType.includes('application/json')) {
            const text = await response.text();
            console.error('Réponse non-JSON:', text.substring(0, 500));
            throw new Error('Réponse serveur invalide');
        }

        const data = await response.json();
        console.log('Réponse QR:', { success: data.success, hasQr: !!data.qr_code, message: data.message });

        if (data.success && data.qr_code) {
            currentResaId = data.reservation_id;
            closeModal();
            setTimeout(() => { openQr(data.qr_code, data.qr_content || '', true); }, 150);
            toast('📋 QR code récupéré !', 'ok');
        } else {
            // Affiche le vrai message d'erreur PHP (ex: "Extension GD non chargée")
            const errMsg = data.message || 'Impossible de récupérer le QR code';
            console.error('Erreur QR serveur:', errMsg);
            toast('❌ ' + errMsg, 'err');
        }
    } catch(error) {
        console.error('Erreur recupererQr:', error);
        toast('❌ ' + error.message, 'err');
    } finally {
        if (btnElement) {
            btnElement.disabled = false;
            btnElement.innerHTML = originalText;
        }
    }
}

/* ── MODAL QR ── */
function openQr(base64, content, alreadyReserved) {
    if (!base64 || !base64.startsWith('data:image')) {
        toast('❌ QR code invalide reçu du serveur', 'err');
        return;
    }

    const qrImg   = document.getElementById('qr-img');
    const qrInfo  = document.getElementById('qr-info');
    const qrEmoji = document.getElementById('qr-emoji');
    const qrTitle = document.getElementById('qr-title');
    const qrSub   = document.getElementById('qr-sub');
    const btnDl   = document.getElementById('btn-dl');
    const gcalBtn = document.getElementById('btn-gcal');

    qrImg.src    = base64;
    qrImg.alt    = 'QR Code de réservation';
    if (qrInfo)  qrInfo.textContent  = content || '';
    if (btnDl)   btnDl.href          = base64;
    if (qrEmoji) qrEmoji.textContent = alreadyReserved ? '📋' : '🎉';
    if (qrTitle) qrTitle.textContent = alreadyReserved ? 'Votre réservation existante' : 'Réservation confirmée !';
    if (qrSub)   qrSub.textContent   = alreadyReserved ? 'Vous avez déjà réservé — voici votre QR code' : 'Votre QR code de confirmation';

    if (gcalBtn) {
        gcalBtn.disabled = false;
        gcalBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg> Ajouter à Google Calendar`;
    }

    document.getElementById('modal-qr').classList.add('open');
}

function closeQr() { document.getElementById('modal-qr').classList.remove('open'); }
document.getElementById('modal-qr').addEventListener('click', e => { if(e.target.id==='modal-qr') closeQr(); });

/* ── MES RÉSERVATIONS CALENDRIER ── */
let myReservationsCalendar = null;

async function showMyReservationsCalendar() {
    const overlay = document.getElementById('modal-my-reservations');
    overlay.classList.add('open');
    
    if (!myReservationsCalendar) {
        await initMyReservationsCalendar();
    } else {
        myReservationsCalendar.refetchEvents();
    }
}

function closeMyReservationsCalendar() {
    document.getElementById('modal-my-reservations').classList.remove('open');
}

document.getElementById('modal-my-reservations').addEventListener('click', e => {
    if(e.target.id === 'modal-my-reservations') closeMyReservationsCalendar();
});

async function initMyReservationsCalendar() {
    const el = document.getElementById('my-reservations-calendar');
    if (!el || typeof FullCalendar === 'undefined') {
        toast('❌ FullCalendar non chargé', 'err');
        return;
    }

    try {
        const response = await fetch('/calendar/my-reservations');
        const data = await response.json();
        
        if (!data.success) {
            toast('❌ Erreur chargement des réservations', 'err');
            return;
        }

        myReservationsCalendar = new FullCalendar.Calendar(el, {
            initialView: 'dayGridMonth',
            locale: 'fr',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            buttonText: {
                today: "Aujourd'hui",
                month: 'Mois',
                week: 'Semaine',
                day: 'Jour'
            },
            events: data.events || [],
            editable: false,
            selectable: false,
            height: 'auto',
            eventClick: function(info) {
                showReservationDetail(info.event);
            },
            eventDidMount: function(info) {
                const p = info.event.extendedProps;
                info.el.title = `${p.groupe}\n${p.statut}`;
                info.el.style.cursor = 'pointer';
            }
        });

        myReservationsCalendar.render();
    } catch (error) {
        console.error('Erreur calendrier réservations:', error);
        toast('❌ Erreur chargement du calendrier', 'err');
    }
}

function showReservationDetail(event) {
    const p = event.extendedProps;
    
    const detail = `
        🎟️ Réservation #${p.reservation_id}
        Groupe: ${p.groupe}
        Formateur: ${p.formateur}
        Statut: ${p.statut}
        Date réservation: ${p.date_reservation}
        Lien réunion: ${p.lien_reunion || 'À confirmer'}
    `;
    
    alert(detail);
}

/* ── LUNA IA ── */
async function askLuna() {
    const input = document.getElementById('ai-q');
    const resp  = document.getElementById('ai-resp');
    const btn   = document.getElementById('btn-luna');
    const q     = input.value.trim();
    if (!q) { toast('💬 Tapez votre question pour LUNA', 'warn'); input.focus(); return; }
    resp.innerHTML = '<span class="spin"></span>LUNA analyse...'; resp.style.display = 'block'; btn.disabled = true;
    try {
        const r  = await fetch('/calendar/ai-suggest', {
            method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({question:q})
        });
        const ct = r.headers.get('content-type') || '';
        if (!ct.includes('application/json')) throw new Error('Réponse non-JSON');
        const d  = await r.json();
        resp.innerHTML = `🌙 <strong>LUNA :</strong> ${esc(d.response||'Pas de réponse.')}`;
    } catch(e) {
        resp.innerHTML = '❌ Impossible de joindre LUNA. Réessayez.';
    } finally {
        btn.disabled = false;
    }
}

document.getElementById('ai-q').addEventListener('keydown', e => { if(e.key==='Enter' && !e.shiftKey) askLuna(); });

/* ── TOASTS ── */
function toast(msg, type='') {
    const c  = document.getElementById('toasts');
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    c.appendChild(el);
    const delay = type === 'err' ? 8000 : 4000;
    setTimeout(() => {
        el.style.transition = 'opacity .3s';
        el.style.opacity = '0';
        setTimeout(() => el.remove(), 320);
    }, delay);
}
</script>

