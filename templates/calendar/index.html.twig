            <div class="legend-item"><div class="legend-dot" style="background:#6B6B8A"></div>Terminée</div>
            <div class="legend-item"><div class="legend-dot" style="background:#FF4757"></div>Annulée</div>
        </div>
    </div>
</div>

{# MODAL SESSION #}
<div class="overlay" id="modal-session">
    <div class="s-modal">
        <button class="m-close" onclick="closeModal()">✕</button>
        <h2 class="m-title" id="m-title">Détail de la session</h2>
